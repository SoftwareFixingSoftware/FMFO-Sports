# =============================================
# FMFO Sports — Configuration
# Copy to .env: cp .env.example .env
# =============================================

# Anthropic API (required) — get at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Server
PORT=3000
NODE_ENV=production

# Default tier until you add auth (free|creator|pro|enterprise)
DEFAULT_TIER=pro

# Database
DB_PATH=./data/fmfo-sports.db

# Rate limits (per 15 min)
RATE_LIMIT_ANALYSIS=30
RATE_LIMIT_CONTENT=20

# Sports data (ESPN is free, no key needed)
SPORTS_API_PROVIDER=espn

# FMFO Platform integration (future)
FMFO_API_URL=https://api.formyfansonly.com
FMFO_API_KEY=
